{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "dialog:default",
    "notification:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "allow-hub-ready",
    "allow-hub-send",
    "allow-hub-close",
    "allow-set-pending-count",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/history.jsonl" },
        { "path": "$APPDATA/history.jsonl.tmp" },
        { "path": "$APPDATA/captures" },
        { "path": "$APPDATA/captures/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.config/parley/settings.json" },
        { "path": "$HOME/.config/parley/themes/*" },
        { "path": "$HOME/.config/inn/themes/*" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/.config/parley/themes" },
        { "path": "$HOME/.config/inn/themes" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.config/parley/settings.json" },
        { "path": "$HOME/.config/parley/themes" },
        { "path": "$HOME/.config/inn/themes" }
      ]
    }
  ]
}
