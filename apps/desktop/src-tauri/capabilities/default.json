{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "dialog:default",
    "notification:default",
    "allow-hub-ready",
    "allow-hub-send",
    "allow-hub-close",
    "allow-set-pending-count"
  ]
}
