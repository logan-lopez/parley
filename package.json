{
  "name": "parley",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "app": "pnpm --filter @parley/desktop tauri dev",
    "install:desktop": "pnpm --filter @parley/desktop install:app",
    "server": "pnpm --filter @parley/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
